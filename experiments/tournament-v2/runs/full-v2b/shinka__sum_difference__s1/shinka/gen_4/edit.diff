+def _fast_stats(a):
+    """Return (num_diffs, num_sums) using counting dicts."""
+    n = len(a)
+    if n < 2:
+        return 0, 0
+    diff_cnt = {}
+    sum_cnt = {}
+    for i in range(n):
+        ai = a[i]
+        for j in range(n):
+            d = ai - a[j]
+            diff_cnt[d] = diff_cnt.get(d, 0) + 1
+            s = ai + a[j]
+            sum_cnt[s] = sum_cnt.get(s, 0) + 1
+    return len(diff_cnt), len(sum_cnt)
+
+
+def _score_fast(a):
+    a = list(set(a))
+    n = len(a)
+    if n < 2:
+        return 0.0
+    nd, ns = _fast_stats(a)
+    if ns <= 1:
+        return 0.0
+    return math.log(nd) / math.log(ns) + (1 - 1 / n) / 100
+
