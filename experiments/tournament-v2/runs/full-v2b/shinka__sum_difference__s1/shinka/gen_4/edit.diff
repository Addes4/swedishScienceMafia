+def _build_dense_golomb(m, gs, gap, rng):
+    """Dense core {0..m} plus a Golomb-like tail offset by m+gap."""
+    core = list(range(m + 1))
+    if gs <= 0:
+        return core
+    g = _greedy_golomb(gs, max(30, gs * gs + 20), rng)
+    offset = m + gap
+    extra = [offset + x for x in g]
+    return core + extra
