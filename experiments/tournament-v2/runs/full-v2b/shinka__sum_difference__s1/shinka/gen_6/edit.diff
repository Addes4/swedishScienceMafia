+def _incremental_score(a):
+    n = len(a)
+    if n < 2:
+        return 0.0
+    diffs = set()
+    sums = set()
+    for i in range(n):
+        ai = a[i]
+        for j in range(i, n):
+            diffs.add(ai - a[j])
+            diffs.add(a[j] - ai)
+            sums.add(ai + a[j])
+    if len(sums) <= 1:
+        return 0.0
+    return math.log(len(diffs)) / math.log(len(sums)) + (1 - 1 / n) / 100
