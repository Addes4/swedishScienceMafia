    "hidden": 0.9683176249213985,
    "code": "\"\"\"Target-residual best fit with a distribution-derived sweet spot.\"\"\"\nimport numpy as np\n_TOTAL = 0\n_COUNT = 0\n_SQ = 0.0\n\ndef priority(item, bins):\n    \"\"\"Return a priority for every bin in `bins`; the item goes to the highest (first on ties).\"\"\"\n    global _TOTAL, _COUNT, _SQ\n    _TOTAL += item\n    _COUNT += 1\n    _SQ += float(item) * item\n    mean = _TOTAL / _COUNT\n    var = max(_SQ / _COUNT - mean * mean, 0.0)\n    sd = var ** 0.5\n    residual = bins - item\n    if _COUNT >= 30:\n        target = 0.9 * mean + 0.15 * sd\n    else:\n        target = 38.0\n    score = -np.abs(residual - target)\n    tight = np.where(residual <= 10, 40000.0 - residual * 2000.0, 0.0)\n    return score + tight\n"
  },
