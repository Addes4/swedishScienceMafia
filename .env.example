# Copy this file to .env and fill in your keys:   cp .env.example .env
# .env is git-ignored, so your keys never get committed.

# Claude, for `python -m autoresearch.loop --provider anthropic`.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Open models through the Hugging Face router (the default provider) read HF_TOKEN from the
# environment, or the token saved by `huggingface-cli login` in ~/.cache/huggingface/token.
